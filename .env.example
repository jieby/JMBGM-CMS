# Database (Supabase PostgreSQL Connection URI)
# Use Supabase Connection String (Transaction pooler port 6543 or Session pooler port 5432)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Payload CMS Secret Key (Generate with: openssl rand -base64 32)
PAYLOAD_SECRET=your-random-payload-secret-here-min-32-chars-long

# Server & Public Site URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
